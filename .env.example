# Copy to .env. Everything is optional for local development.
# development (your computer, Codespaces), preview (shared test site, demo payments), production (live)
APP_ENV=development
SECRET_KEY=
ADMIN_PASSWORD=change-me
PUBLIC_URL=http://localhost:3000
BUSINESS_TIMEZONE=America/New_York
# Blank = SQLite file in instance/. Vercel needs Postgres (Neon fills this in).
# DATABASE_URL=postgresql://user:pass@host/solescape

# Leave blank for demo mode: no real payments. Ignored when APP_ENV=preview.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Leave blank and emails are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OWNER_EMAIL=solescapefootspa@gmail.com

# Rate limit counts. memory:// keeps them per server copy. A redis:// URL shares them (needs the redis package).
# RATELIMIT_STORAGE_URI=memory://
